{
  "schema_version": 1,
  "output_root": "runs",
  "defaults": {
    "jobs": 2,
    "timeout_seconds": 7200
  },
  "harnesses": {
    "pi": {
      "binary": "pi",
      "auth_file": "~/.pi/agent/auth.json",
      "models": {
        "flash": "deepseek-v4-flash",
        "pro": "deepseek-v4-pro"
      }
    },
    "codex-ds": {
      "binary": "codex",
      "profile": "deepseek",
      "profile_file": "~/.codex/deepseek.config.toml",
      "model_catalog": "~/.codex/models.json",
      "models": {
        "flash": "deepseek-v4-flash",
        "pro": "deepseek-v4-pro"
      }
    }
  },
  "matrix": [
    {
      "harness": "pi",
      "model": "flash",
      "reasoning": "high"
    },
    {
      "harness": "pi",
      "model": "flash",
      "reasoning": "max"
    },
    {
      "harness": "pi",
      "model": "pro",
      "reasoning": "high"
    },
    {
      "harness": "pi",
      "model": "pro",
      "reasoning": "max"
    },
    {
      "harness": "codex-ds",
      "model": "flash",
      "reasoning": "high"
    },
    {
      "harness": "codex-ds",
      "model": "flash",
      "reasoning": "max"
    },
    {
      "harness": "codex-ds",
      "model": "pro",
      "reasoning": "high"
    },
    {
      "harness": "codex-ds",
      "model": "pro",
      "reasoning": "max"
    }
  ]
}
